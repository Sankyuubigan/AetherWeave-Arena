extends StaticBody3D
## Q25-B (26.11.26): невидимая монолит-подложка пола MainArena (бокс 100×8×100,
## топ y=0), строится генератором; этот скрипт — runtime-компонент на ней.
## Родной пол арены = бокс толщиной 1 м (mid-plane −0.5): одобренный покой желе
## −0.5 достигает мид-плейна бокса → солвер выбрасывает точки через ДНО бокса →
## каскадный провал в пустоту («упал в пропасть», вердикт юзера 21.11.26).
## pack() НЕ сериализует правки вложенных узлов инстанса → отключение родного
## бокса делаем runtime'ом здесь, не инлайн в генераторе.
## Итог: монолит — единственная коллизия пола: для софтбоди нет мид-плейна
## до −4, провал невозможен, сэндвича floor+backing (выдавливание вбок) нет.

func _ready() -> void:
	var arena := get_parent().get_node_or_null("Arena") as StaticBody3D
	if arena == null:
		print("[FLOOR-MONOLITH] sibling «Arena» не найден — пол арены не отключён")
		return
	var n := 0
	for c in arena.get_children():
		if c is CollisionShape3D:
			c.set_deferred("disabled", true)
			n += 1
	print("[FLOOR-MONOLITH] пол арены отключён (%d коллизий) — монолит FloorBacking единственная коллизия пола" % n)
